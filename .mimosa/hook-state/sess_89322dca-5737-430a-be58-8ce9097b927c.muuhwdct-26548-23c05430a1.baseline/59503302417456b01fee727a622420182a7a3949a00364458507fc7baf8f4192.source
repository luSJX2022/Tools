"""从 uiautomator 导出的 XML 里找出某个文字节点的中心坐标。

写成文件而不是 python -c，是为了避开 Windows 命令行编码把中文参数弄坏。
用法：adb shell cat /sdcard/ui.xml | python find_node.py
"""
import re
import sys

# 在应用内登录课表（推荐）
KEY = "\u5728\u5e94\u7528\u5185\u767b\u5f55\u8bfe\u8868"

xml = sys.stdin.buffer.read().decode("utf-8", "replace")

node_re = re.compile(r"<node[^>]*>")
text_re = re.compile(r'text="([^"]*)"')
bounds_re = re.compile(r'bounds="\[(\d+),(\d+)\]\[(\d+),(\d+)\]"')

for m in node_re.finditer(xml):
    tag = m.group(0)
    t = text_re.search(tag)
    b = bounds_re.search(tag)
    if not t or not b:
        continue
    if KEY in t.group(1):
        a, bb, c, d = (int(v) for v in b.groups())
        print((a + c) // 2, (bb + d) // 2)
        break
else:
    print("", "")
