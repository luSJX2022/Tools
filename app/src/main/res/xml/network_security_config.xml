<?xml version="1.0" encoding="utf-8"?>
<!--
  学校的强智教务系统大多还在用 HTTP，或者用自签名的 HTTPS 证书，所以这里：
  1. 允许明文 HTTP（否则所有 http:// 的学校都连不上）；
  2. 除了系统证书，也信任用户自己安装的证书（用户可以把学校的自签 CA 装进手机）。
  这等于对用户主动安装的证书放行，属于明知取舍；换来的是能用校内网那些不合规的证书。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
