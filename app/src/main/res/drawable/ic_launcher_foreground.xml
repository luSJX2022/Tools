<?xml version="1.0" encoding="utf-8"?>
<!--
  Tools 图标前景：一张带装订环和表头的白色日历卡，卡上是 7 个彩色日期格
  （一周七天，其中一格橙色 = 「今天」），右下角压一枚橙色圆形播放徽章 ——
  课表为主、播放器为辅，正好对应「工具页 → 课表 / 播放器」的结构。

  自适应图标的前景会被裁：蒙版圆半径约 36，内容都收在半径 35 以内
  （卡片角 34、徽章最远点 34.7），圆形蒙版下不会缺角。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 卡片：29,31 到 79,77，圆角 8 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M37,31 h34 a8,8 0 0 1 8,8 v30 a8,8 0 0 1 -8,8 h-34 a8,8 0 0 1 -8,-8 v-30 a8,8 0 0 1 8,-8 z" />

    <!-- 表头：卡片顶部 12dp 高，深蓝，只圆上角 -->
    <path
        android:fillColor="#1565C0"
        android:pathData="M37,31 h34 a8,8 0 0 1 8,8 v4 h-50 v-4 a8,8 0 0 1 8,-8 z" />

    <!-- 装订环：两个白色圆头小柱，插进表头 2dp -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M39,28 a2.5,2.5 0 0 1 5,0 v5 h-5 z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M64,28 a2.5,2.5 0 0 1 5,0 v5 h-5 z" />

    <!-- 日期格：7.5x7.5 圆角方块，上排 4 格下排 3 格 = 一周七天；橙格是「今天」。
         下排最后一格故意让徽章压住右半边（分层贴纸的层次感）。 -->
    <path
        android:fillColor="#1565C0"
        android:pathData="M34.9,49 h3.7 a1.9,1.9 0 0 1 1.9,1.9 v3.7 a1.9,1.9 0 0 1 -1.9,1.9 h-3.7 a1.9,1.9 0 0 1 -1.9,-1.9 v-3.7 a1.9,1.9 0 0 1 1.9,-1.9 z" />
    <path
        android:fillColor="#FF6B35"
        android:pathData="M46.4,49 h3.7 a1.9,1.9 0 0 1 1.9,1.9 v3.7 a1.9,1.9 0 0 1 -1.9,1.9 h-3.7 a1.9,1.9 0 0 1 -1.9,-1.9 v-3.7 a1.9,1.9 0 0 1 1.9,-1.9 z" />
    <path
        android:fillColor="#1565C0"
        android:pathData="M57.9,49 h3.7 a1.9,1.9 0 0 1 1.9,1.9 v3.7 a1.9,1.9 0 0 1 -1.9,1.9 h-3.7 a1.9,1.9 0 0 1 -1.9,-1.9 v-3.7 a1.9,1.9 0 0 1 1.9,-1.9 z" />
    <path
        android:fillColor="#42A5F5"
        android:pathData="M69.4,49 h3.7 a1.9,1.9 0 0 1 1.9,1.9 v3.7 a1.9,1.9 0 0 1 -1.9,1.9 h-3.7 a1.9,1.9 0 0 1 -1.9,-1.9 v-3.7 a1.9,1.9 0 0 1 1.9,-1.9 z" />
    <path
        android:fillColor="#42A5F5"
        android:pathData="M34.9,61 h3.7 a1.9,1.9 0 0 1 1.9,1.9 v3.7 a1.9,1.9 0 0 1 -1.9,1.9 h-3.7 a1.9,1.9 0 0 1 -1.9,-1.9 v-3.7 a1.9,1.9 0 0 1 1.9,-1.9 z" />
    <path
        android:fillColor="#1565C0"
        android:pathData="M46.4,61 h3.7 a1.9,1.9 0 0 1 1.9,1.9 v3.7 a1.9,1.9 0 0 1 -1.9,1.9 h-3.7 a1.9,1.9 0 0 1 -1.9,-1.9 v-3.7 a1.9,1.9 0 0 1 1.9,-1.9 z" />
    <path
        android:fillColor="#42A5F5"
        android:pathData="M57.9,61 h3.7 a1.9,1.9 0 0 1 1.9,1.9 v3.7 a1.9,1.9 0 0 1 -1.9,1.9 h-3.7 a1.9,1.9 0 0 1 -1.9,-1.9 v-3.7 a1.9,1.9 0 0 1 1.9,-1.9 z" />

    <!-- 播放徽章：圆心 (71,69) 半径 12，橙色 -->
    <path
        android:fillColor="#FF6B35"
        android:pathData="M71,57 a12,12 0 1 0 0,24 a12,12 0 1 0 0,-24 z" />

    <!-- 白色播放三角：三个角磨圆。路径逆时针绕（左边→下→顶点），圆角 sweep 必须是 0，
         写 1 会往内凹成豁口。 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M67,63.8 L67,74.2 A1.8,1.8 0 0 0 68.55,75.1 L77.45,69.9 A1.8,1.8 0 0 0 77.45,68.1 L68.55,62.9 A1.8,1.8 0 0 0 67,63.8 Z" />
</vector>
